# TLS termination for the storefront.
#
# Caddy obtains and renews a Let's Encrypt certificate on its own, which is why
# it is here rather than certbot: there is no renewal cron to forget, and no
# certificate to copy into a container.
#
# It also redirects http to https automatically, so nothing behind it ever sees
# a plain request from a customer.

{
	# Where Let's Encrypt sends expiry warnings if renewal ever stops working.
	email {$ACME_EMAIL}

	# Uncomment while testing to use the staging CA. Real certificates are rate
	# limited to five per domain per week, and a misconfigured DNS record can
	# burn through that in an afternoon.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_DOMAIN} {
	# HSTS belongs on the terminator, not on nginx behind it: nginx never sees
	# an https request and so cannot honestly assert the site is https-only.
	# No preload directive - that submits the domain to a browser-shipped list
	# and is very hard to undo, which is not a decision to make by default.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Caddy announces itself in every response otherwise.
	header -Server

	# Caddy sets X-Forwarded-Proto, X-Forwarded-For and X-Forwarded-Host from
	# the real request; nginx now prefers those over its own scheme.
	reverse_proxy web:80 {
		health_uri /healthz
		health_interval 10s
		health_timeout 3s
	}

	log {
		output stdout
		format console
	}
}
