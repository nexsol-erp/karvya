# ---- copy to .env and fill in. never commit .env ----

# database (postgresql)
POSTGRES_DB=karvya
POSTGRES_USER=karvya
POSTGRES_PASSWORD=change-me-strong

# backend
SPRING_PROFILES_ACTIVE=prod
APP_BASE_URL=http://localhost

# Session cookie Secure flag. Leave true in production: without TLS in front,
# the cookie travels in the clear. Set false ONLY for an HTTP-only test harness.
APP_COOKIE_SECURE=true

# first admin - created on first boot, forced to change password at first login
APP_ADMIN_USERNAME=admin
APP_ADMIN_EMAIL=owner@example.com
APP_ADMIN_PASSWORD=change-me-at-first-login

# fallback only: the WhatsApp number is normally set in admin site settings.
# Order notifications go to APP_ADMIN_NOTIFICATION_EMAIL.
APP_WHATSAPP_NUMBER=
APP_ADMIN_NOTIFICATION_EMAIL=owner@example.com

# media
APP_STORAGE_DIR=/var/lib/karvya/media

# openapi - keep false in production unless deliberately exposing docs
APP_OPENAPI_ENABLED=false

# smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=orders@example.com
